node_modules/
dist/
out/

# 市场插件运行产物必须入库：Git 源稀疏检出只拿跟踪文件
!marketplace/plugins/echarts/dist/
marketplace/plugins/echarts/dist/*
!marketplace/plugins/echarts/dist/marketplace.js
!marketplace/plugins/echarts/dist/i18n/
!marketplace/plugins/echarts/dist/i18n/**
!marketplace/plugins/data-preview/dist/
!marketplace/plugins/data-preview/dist/**

# macOS 目录元数据
.DS_Store

# canvas 从共享源派生的构建输入（npm run styles 生成，不入库）
packages/canvas/src/styles/designer.css
packages/canvas/src/core/icons.ts

# demos 验收产物（verify-demo.mjs 每次跑都会重新截图）
demos/evidence/

# demos 子工程直挂资产：npm install 的 postinstall 从 @worm-print-platform/canvas 的 dist 拷来
demos/apps/*/public/vendor/
demos/apps/*/dist/

# demo 启动时由 sync-plugin 生成的市场安装语言资源
demos/apps/*/.worm-print/i18n/

# demos 子工程的示例字体：单个体积 1.5~8MB 不入库，需要时自行放置
demos/apps/*/public/fonts/

# electron-builder 本地下载缓存（构建时自动生成，不入库）
.cache/

# 教学视频运行目录（技能源在 .agents/skills/making-douyin-videos，运行产物不入库）
.video/
.video-*/

# AI 生成图片临时目录，不入库
vibe_images/

# 本地 AI 工具状态（会话令牌、端口、本地权限缓存），不入库
.superpowers/
.qoder/
.workbuddy/
.idea/**
**/.mimosa/**

# 本地 MCP 连接配置（含 Bearer 令牌），不入库
opencode.json

# 本地待办清单，不入库
todo.md
**/.mimosa/**
.idea/**