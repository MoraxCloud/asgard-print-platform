{
  "name": "@worm-print-platform/plugin-kit",
  "version": "1.5.1",
  "type": "module",
  "description": "打印模板自定义元素的框架无关设计器 UI 契约与注册表：插件写一份 DOM 渲染能力，canvas（原生）与 /vue3（门面）同时消费",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "worm <liu_long_qqcom@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worm-longliu/worm-print-platform.git"
  },
  "keywords": [
    "print",
    "template",
    "designer",
    "plugin",
    "framework-agnostic"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && node ../../scripts/inject-license-banner.mjs dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@worm-print-platform/core": "^1.5.1"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3",
    "vitest": "^1.6.0"
  }
}
